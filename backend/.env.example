# Supabase connection string — use the "Transaction" pooler (port 6543) for the
# running app, and the direct connection (port 5432) if you need migrations to
# see newly created extensions immediately. Both work for migration:run.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase requires SSL; set to false for a local Postgres instance.
DATABASE_SSL=true

# --- Local Postgres (current dev setup) ---
# See backend/db/DATABASE_LOG.md and backend/db/setup/001_create_dev_db_and_role.sql
# DATABASE_URL=postgresql://queenscut_dev:queenscut_dev_local@localhost:5432/queenscut_dev
# DATABASE_SSL=false

NODE_ENV=development
PORT=3000

# Comma-separated list of allowed web/mobile origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
